# Copier ce fichier vers .env. Aucune valeur n'est necessaire pour le mode simule :
# sans .env, l'application vise la base du docker-compose.yml et le simulateur de paiement.

# Laisser vide pour la base locale de docker compose.
DATABASE_URL=
PORT=
APP_BASE_URL=
COOKIE_SECURE=
TRUST_PROXY=

# simulator (par defaut) ou stripe.
PAYMENT_PROVIDER=

# Secret de signature des evenements du simulateur. Vide : genere au demarrage.
SIMULATOR_WEBHOOK_SECRET=

# Mode test de Stripe uniquement : une cle de production est refusee au demarrage.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ESSENTIEL=
STRIPE_PRICE_CONFORT=
STRIPE_PRICE_INTEGRAL=
