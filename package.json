{
  "name": "abonnements-web",
  "version": "1.0.0",
  "private": true,
  "description": "Gestion d'abonnements pour une salle de sport fictive : Express, PostgreSQL, React, Stripe en mode test.",
  "license": "MIT",
  "author": "Koray Akyurek",
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "workspaces": [
    "server",
    "client",
    "e2e"
  ],
  "scripts": {
    "demo": "node scripts/demo.js",
    "dev": "node scripts/dev.js",
    "lint": "eslint .",
    "test": "npm test -w server",
    "test:e2e": "npm test -w e2e",
    "build": "npm run build -w client",
    "db:migrate": "npm run db:migrate -w server",
    "db:seed": "npm run db:seed -w server"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0"
  }
}
